{%- doc -%}
  Generates CSS custom properties for every scheme in the `color_schemes` color_scheme_group
  (config/settings_schema.json), as `.color-scheme-{id}` classes — the Beast & Branch equivalent
  of Shopify's own documented color_scheme_group CSS pattern. Elements carrying one of these
  classes (see sections/section.liquid, sections/footer.liquid) get the full brand token set:
  Horizon's existing button/input/background/foreground names, plus this project's own
  (surface, ornament, foreground-heading/-muted, primary/-hover, border-strong).

  Rendered once from layout/theme.liquid.
{%- enddoc -%}

{% style %}
  {% for scheme in settings.color_schemes %}
    .color-scheme-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-surface: {{ scheme.settings.surface }};
      --color-foreground-heading: {{ scheme.settings.foreground_heading }};
      --color-foreground: {{ scheme.settings.foreground }};
      --color-foreground-muted: {{ scheme.settings.foreground_muted }};
      --color-primary: {{ scheme.settings.primary }};
      --color-primary-hover: {{ scheme.settings.primary_hover }};
      --color-ornament: {{ scheme.settings.ornament }};
      --color-border: {{ scheme.settings.border }};
      --color-border-strong: {{ scheme.settings.border_strong }};
      --color-primary-button-background: {{ scheme.settings.primary_button_background }};
      --color-primary-button-text: {{ scheme.settings.primary_button_text }};
      --color-primary-button-border: {{ scheme.settings.primary_button_border }};
      --color-primary-button-hover-background: {{ scheme.settings.primary_button_hover_background }};
      --color-primary-button-hover-text: {{ scheme.settings.primary_button_hover_text }};
      --color-primary-button-hover-border: {{ scheme.settings.primary_button_hover_border }};
      --color-secondary-button-background: {{ scheme.settings.secondary_button_background }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_text }};
      --color-secondary-button-border: {{ scheme.settings.secondary_button_border }};
      --color-secondary-button-hover-background: {{ scheme.settings.secondary_button_hover_background }};
      --color-secondary-button-hover-text: {{ scheme.settings.secondary_button_hover_text }};
      --color-secondary-button-hover-border: {{ scheme.settings.secondary_button_hover_border }};
      --color-input-background: {{ scheme.settings.input_background }};
      --color-input-text: {{ scheme.settings.input_text }};
      --color-input-border: {{ scheme.settings.input_border }};
      background-color: var(--color-background);
      color: var(--color-foreground);
    }
  {% endfor %}
{% endstyle %}
