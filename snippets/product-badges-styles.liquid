{%- doc -%}
  Product badge styles consolidated into a single snippet.

  @example
  {% render 'product-badges-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-end: calc(var(--badge-inset) + var(--padding-inline-end));
  }

  .product-badges__badge {
    --badge-font-size: var(--font-size--xs);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }

  /* Small rotated-square "lozenge" pip preceding every badge's label, per the design system. */
  .product-badges__badge-pip {
    flex: none;
    width: 4px;
    height: 4px;
    background: currentColor;
    transform: rotate(45deg);
  }

  /*
   * Fixed colors for the brand's own badge kinds (New/Beast/Branch/Clyde's Pick) — these have no
   * theme setting, unlike sale/sold-out, so they read consistently over any product artwork.
   */
  .product-badges__badge--new {
    color: #1E1914;
    background: #FAF4E6;
    border: 1px solid #1E1914;
  }

  .product-badges__badge--beast {
    color: #EE7B55;
    background: #0C0D14;
    border: 1px solid #A8321B;
  }

  .product-badges__badge--branch {
    color: #EFE8D2;
    background: #46622B;
    border: 1px solid #46622B;
  }

  .product-badges__badge--picks {
    color: #1E1914;
    background: #D8BC7E;
    border: 1px solid #A9853F;
  }
{% endstylesheet %}
