{% doc %}
  Beast & Branch: self-hosts the brand's Grenze/Alegreya/Alegreya SC webfonts (not in Shopify's
  font picker library) and repoints Horizon's font-role CSS variables at them. Rendered after
  `theme-styles-variables` and `color-palette` so these overrides win the cascade.
{% enddoc %}

{{ 'Grenze-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
{{ 'Alegreya-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}

{% style %}
  @font-face {
    font-family: 'Grenze';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'Grenze-400.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'Alegreya';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'Alegreya-400.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'Alegreya';
    font-style: italic;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'Alegreya-400-italic.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'Alegreya SC';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'AlegreyaSC-500.woff2' | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'Alegreya SC';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'AlegreyaSC-700.woff2' | asset_url }}') format('woff2');
  }

  :root {
    --font-heading--family: 'Grenze', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --font-heading--style: normal;
    --font-heading--weight: 600;

    --font-body--family: 'Alegreya', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --font-body--style: normal;
    --font-body--weight: 400;

    --font-subheading--family: 'Alegreya SC', 'Alegreya', Georgia, serif;
    --font-subheading--style: normal;
    --font-subheading--weight: 700;

    --font-accent--family: 'Alegreya SC', 'Alegreya', Georgia, serif;
    --font-accent--style: normal;
    --font-accent--weight: 500;
  }
{% endstyle %}
