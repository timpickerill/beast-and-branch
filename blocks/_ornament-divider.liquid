{% render 'ornament-divider', id: block.id, settings: block.settings, attributes: true %}

{% schema %}
{
  "name": "t:names.ornament_divider",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "glyph",
      "label": "t:settings.ornament_glyph",
      "options": [
        {
          "value": "diamond",
          "label": "t:options.ornament_diamond"
        },
        {
          "value": "stars",
          "label": "t:options.ornament_stars"
        },
        {
          "value": "fleuron",
          "label": "t:options.ornament_fleuron"
        },
        {
          "value": "rule",
          "label": "t:options.ornament_rule"
        }
      ],
      "default": "diamond"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "t:settings.length",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 60
    },
    {
      "type": "select",
      "id": "alignment_horizontal",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.width_percent < 100 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.ornament_divider",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
